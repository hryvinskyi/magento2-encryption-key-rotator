includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 10
    phpVersion: 80100
    paths:
        - src
        - tests
        - config
        - tools
        - bin/key-rotator
        - build/compile.php
        - build/smoke.php
